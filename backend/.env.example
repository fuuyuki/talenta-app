# Copy this file to `backend/.env` for running the backend outside Docker:
#   cp .env.example .env
#
# Inside Docker, docker-compose.yml provides these variables instead.

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# If the password contains special characters (@, :, /, #, ...), they must be
# percent-encoded in the URL (for example, `@` becomes `%40`).
DATABASE_URL=postgresql://talenta_admin:change-me@localhost:5433/talenta_db

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
# Generate a strong secret, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=3001
