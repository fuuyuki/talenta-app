generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model articles {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id    String    @db.Uuid
  slug         String    @unique
  title        String
  excerpt      String?
  body_md      String
  published    Boolean   @default(false)
  published_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [author_id], references: [id], onUpdate: NoAction)
}

model cities {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  members members[]
}

model groups {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  mentor_id String?    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  mentor    members?   @relation("groups_mentor_idTousers", fields: [mentor_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_groups_mentor")
  sessions  sessions[]
  members   members[]
}

/// Master roster. A member can exist without ever having a login account:
/// `user_id` stays NULL until an admin creates one. Deleting the account
/// clears the link instead of deleting the member.
model members {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?       @unique(map: "uq_members_user") @db.Uuid
  full_name       String
  email           String?       @unique
  phone           String?
  gender          String?
  birth_place     String?
  birth_date      DateTime?     @db.Date
  address         String?
  sma_id          Int?
  domisili_id     Int?
  occupation_id   Int?
  university_id   Int?
  faculty         String?
  major           String?
  entry_year      Int?          @db.SmallInt
  graduation_year Int?          @db.SmallInt
  mentorship_tier String?
  activity_status String        @default("active")
  group_id        String?       @db.Uuid
  mentor_id       String?       @db.Uuid
  joined_at       DateTime      @default(now()) @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  user            users?        @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  group           groups?       @relation(fields: [group_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_members_group")
  mentor          members?      @relation("membersTousers", fields: [mentor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  mentees         members[]     @relation("membersTousers")
  cities          cities?       @relation(fields: [domisili_id], references: [id], onUpdate: NoAction)
  occupations     occupations?  @relation(fields: [occupation_id], references: [id], onUpdate: NoAction)
  schools         schools?      @relation(fields: [sma_id], references: [id], onUpdate: NoAction)
  universities    universities? @relation(fields: [university_id], references: [id], onUpdate: NoAction)

  member_organizations               member_organizations[]
  groups_groups_mentor_idTousers     groups[]             @relation("groups_mentor_idTousers")
  sessions_sessions_mentee_idTousers sessions[]           @relation("sessions_mentee_idTousers")
  sessions_sessions_mentor_idTousers sessions[]           @relation("sessions_mentor_idTousers")

  @@index([group_id], map: "idx_members_group")
  @@index([mentor_id], map: "idx_members_mentor")
  @@index([activity_status], map: "idx_members_status")
  @@index([full_name], map: "idx_members_full_name")
}

model occupations {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  members members[]
}

model organizations {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique
  category             String?
  member_organizations member_organizations[]
}

model schools {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  members members[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sessions {
  id                              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id                        String?   @db.Uuid
  mentor_id                       String?   @db.Uuid
  mentee_id                       String?   @db.Uuid
  scheduled_at                    DateTime? @db.Timestamptz(6)
  completed_at                    DateTime? @db.Timestamptz(6)
  title                           String?
  agenda                          String?
  notes                           String?
  private_notes                   String?
  status                          String    @default("scheduled")
  created_at                      DateTime  @default(now()) @db.Timestamptz(6)
  groups                          groups?   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mentee                          members?  @relation("sessions_mentee_idTousers", fields: [mentee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mentor                          members?  @relation("sessions_mentor_idTousers", fields: [mentor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model universities {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  members members[]
}

model member_organizations {
  member_id       String        @db.Uuid
  organization_id Int
  joined_at       DateTime?     @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members         members       @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([member_id, organization_id])
}

/// Authentication only. Profile / roster data lives in `members`;
/// authorisation lives in `user_roles`.
model users {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique
  password_hash String
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)
  articles      articles[]
  member        members?
  user_roles    user_roles[]
}

model roles {
  id         Int          @id @default(autoincrement())
  code       String       @unique
  name       String
  user_roles user_roles[]
}

model user_roles {
  user_id    String   @db.Uuid
  role_id    Int
  granted_at DateTime @default(now()) @db.Timestamptz(6)
  roles      roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
  @@index([role_id], map: "idx_user_roles_role")
}

model registration_requests {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name  String
  email      String   @unique
  phone      String?
  reason     String?
  status     String   @default("pending")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}
