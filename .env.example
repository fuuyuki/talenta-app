# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# These variables are used by docker-compose.yml for variable substitution.

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DB_USER=talenta_admin
DB_PASSWORD=change-me
DB_NAME=talenta_db
DB_PORT=5433

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
BACKEND_PORT=3001
# Generate a strong secret, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First-run superadmin bootstrap. Leave empty if an admin already exists.
# Created only when the database has no admin account.
# Use a password of at least 12 characters, or provide a bcrypt hash instead.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# SUPERADMIN_PASSWORD_HASH=$2b$12$...

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
FRONTEND_PORT=3000
# Public origin of the API through Nginx (host port 8080).
NEXT_PUBLIC_API_URL=http://localhost:8080/api
